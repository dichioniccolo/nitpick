{
  "name": "@nitpick/root",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/drivers/*",
      "packages/code-graph/*",
      "packages/review/*",
      "packages/identity/*"
    ],
    "catalog": {
      "@anthropic-ai/sdk": "1.3.0",
      "@effect/language-service": "0.87.5",
      "@effect/platform-bun": "4.0.6",
      "@effect/sql-pg": "4.0.6",
      "@effect/sql-pglite": "4.0.6",
      "@effect/vitest": "4.0.6",
      "@electric-sql/pglite": "0.5.11",
      "@tailwindcss/postcss": "^4",
      "@types/node": "^26.6.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "drizzle-kit": "1.0.0-rc.5-ab785fc",
      "drizzle-orm": "1.0.0-rc.5-ab785fc",
      "effect": "4.0.6",
      "nanotar": "0.3.0",
      "next": "16.4.3",
      "octokit": "5.0.5",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tailwindcss": "^4",
      "tree-sitter-wasms": "0.1.13",
      "typescript": "^7.0.2",
      "vitest": "^5.0.5",
      "web-tree-sitter": "0.25.10",
      "better-auth": "1.7.14",
      "pg": "^8.16.0",
      "uuid": "14.0.3",
      "@types/pg": "^8.15.0",
      "@next/playwright": "16.4.3",
      "@playwright/test": "1.64.1"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env run scripts/migrate.ts",
    "dev": "turbo run dev",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "lefthook install",
    "sync": "syncpack lint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:build": "EXPOSE_TESTING_API=1 bun run --cwd apps/web build",
    "e2e:oauth": "bun run scripts/e2e/oauth.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@electric-sql/pglite-socket": "0.2.17",
    "@next/playwright": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "catalog:",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.89.0",
    "pg": "catalog:",
    "syncpack": "^14.0.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "26.12.1"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.5-ab785fc": "patches/drizzle-orm@1.0.0-rc.5-ab785fc.patch",
    "nanotar@0.3.0": "patches/nanotar@0.3.0.patch"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
