{
  "strictness": "balanced",
  "triggerOnUpdates": false,
  "skipDrafts": true,
  "ignoreAuthors": ["dependabot[bot]"],
  "baseBranches": ["main", "release"],
  "ignorePaths": ["*.generated.ts", "docs/**"],
  "skipLabels": ["no-review"],
  "rules": ["Database calls go through a repository class"],
  "maxFindings": 15,
  "diagram": true
}
