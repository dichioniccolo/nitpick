{
  "name": "@nitpick/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --target=bun --outfile=dist/main.js --external=pg-native && bun build src/migrate.ts --target=bun --outfile=dist/migrate.js --external=pg-native && bash scripts/copy-wasm.sh",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "bun --env-file=../../.env --watch src/main.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@nitpick/anthropic": "workspace:*",
    "@nitpick/code-graph-server": "workspace:*",
    "@nitpick/github": "workspace:*",
    "@nitpick/postgres": "workspace:*",
    "@nitpick/review-domain": "workspace:*",
    "@nitpick/review-server": "workspace:*",
    "@nitpick/tree-sitter": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
